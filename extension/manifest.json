{
  "manifest_version": 3,
  "name": "WebRTC Guard",
  "version": "0.1.0",
  "description": "阻止已授权网页创建 WebRTC 连接。实验版本；会影响网页通话和点对点传输。",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["guard.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
